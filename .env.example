NODE_ENV=development

# Telegram
BOT_TOKEN=

# Jira Server / Data Center (no trailing slash)
JIRA_BASE_URL=

# SQLite database path
DATABASE_URL=file:./dev.db

# AES-256-GCM key for encrypting PAT — 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JIRA_TOKEN_ENCRYPTION_KEY=

# Only for scripts/test-jira-auth.ts — not used by the bot
TEST_JIRA_TOKEN=

# Timezone for date/time operations (default: Asia/Tehran)
APP_TIMEZONE=Asia/Tehran