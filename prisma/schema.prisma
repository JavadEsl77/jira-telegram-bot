generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  telegramId      BigInt   @unique
  jiraUsername    String?
  jiraDisplayName String?
  jiraAccountId   String?
  jiraToken       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
